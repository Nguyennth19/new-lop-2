{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lop 2 Variant Record with Visual Intent v1",
  "description": "Backward compatible extension; original question properties and grading remain unchanged. 'visualIntent' optional on legacy questions.",
  "type": "object",
  "required": [
    "question_id",
    "lesson_id",
    "type",
    "prompt"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "visualIntent": {
      "enum": [
        "decorative",
        "quantity",
        "counting"
      ]
    },
    "quantityMode": {
      "enum": [
        "symbolic",
        "exact",
        "counting",
        "literal"
      ]
    },
    "subject": {
      "type": "string",
      "maxLength": 100
    },
    "semanticTags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "requestedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "visualIntent"
        ],
        "properties": {
          "visualIntent": {
            "const": "decorative"
          }
        }
      },
      "then": {
        "required": [
          "quantityMode"
        ],
        "properties": {
          "quantityMode": {
            "const": "symbolic"
          }
        },
        "not": {
          "required": [
            "requestedCount"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "visualIntent"
        ],
        "properties": {
          "visualIntent": {
            "enum": [
              "quantity",
              "counting"
            ]
          }
        }
      },
      "then": {
        "required": [
          "quantityMode",
          "requestedCount"
        ],
        "properties": {
          "quantityMode": {
            "enum": [
              "exact",
              "counting",
              "literal"
            ]
          }
        }
      }
    }
  ]
}
