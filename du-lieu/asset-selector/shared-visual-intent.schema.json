{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lop2 Shared Asset Selector Request v1",
  "description": "Lesson-agnostic, staging-only request contract; no Question ID to Asset ID hardcoded mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visualIntent",
    "quantityMode"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "maxLength": 128
    },
    "lesson_id": {
      "type": "string",
      "maxLength": 128
    },
    "subjectArea": {
      "enum": [
        "toan",
        "tieng_viet",
        "tieng_anh"
      ]
    },
    "type": {
      "type": "string",
      "maxLength": 48
    },
    "prompt": {
      "type": "string",
      "maxLength": 2000
    },
    "unit": {
      "type": "string",
      "maxLength": 100
    },
    "subject": {
      "type": "string",
      "maxLength": 100
    },
    "semanticTags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "visualIntent": {
      "enum": [
        "decorative",
        "quantity",
        "counting"
      ]
    },
    "quantityMode": {
      "enum": [
        "symbolic",
        "exact",
        "counting",
        "literal"
      ]
    },
    "requestedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "visualIntent": {
            "const": "decorative"
          }
        },
        "required": [
          "visualIntent"
        ]
      },
      "then": {
        "properties": {
          "quantityMode": {
            "const": "symbolic"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visualIntent": {
            "enum": [
              "quantity",
              "counting"
            ]
          }
        },
        "required": [
          "visualIntent"
        ]
      },
      "then": {
        "required": [
          "requestedCount"
        ]
      }
    }
  ]
}
