  "schemaVersion": "g7-4-b5-14a-visual-mode-policy-v1",
  "scope": "TEST_ONLY_POLICY_ONLY",
  "status": "APPROVED_FOR_POLICY_QA_NOT_RUNTIME",
  "featureActivation": false,
  "lessonMutation": false,
  "modes": {
    "EXACT_COUNT": {
      "definition": "Render exact objects to support direct counting/grouping/comparison.",
      "requires": [
        "explicit_visual_intent",
        "positive_safe_integer_quantity",
        "canonical_count_unit",
        "count_safe_approved_asset",
        "quantity_and_unit_match",
        "renderer_count_limit"
      ],
      "fallbackOnFailure": "BLOCK_EXACT_COUNT_OR_USE_EXPLICIT_PEDAGOGIC_REDESIGN_NEVER_SILENT_DOWNGRADE",
      "illustrativeQuantityInference": false
    },
    "REPRESENTATIVE": {
      "definition": "One or small bounded set of symbolic assets depicts question context only.",
      "requires": [
        "semantic_approved_asset",
        "context_match"
      ],
      "defaultRepresentativeIcons": 1,
      "visualQuantity": "NON_NUMERIC",
      "neverDeriveQuestionCountFromIcons": true,
      "preserveNumbersInPromptAndSummary": true,
      "assetFallback": "EXISTING_ILLUSTRATION_OR_ACCESSIBLE_PLACEHOLDER"
    },
    "DECORATIVE": {
      "definition": "Optional context or ornament, not part of mathematical reasoning.",
      "renderRequired": false,
      "defaultShow": false,
      "visualQuantity": "NONE",
      "neverDeriveQuestionCountFromIcons": true,
      "assetFallback": "NO_IMAGE"
    }
  },
  "precedence": [
    "explicit_pedagogical_visual_intent",
    "approved_semantic_asset",
    "count_permission_if_count",
    "layout_constraints"
  ],
  "rules": [
    {
      "id": "POL-A-01",
      "condition": "Word problem with quantities, skill = mathematical modeling/reading comprehension and not direct visual counting",
      "decision": "REPRESENTATIVE"
    },
    {
      "id": "POL-A-02",
      "condition": "Student must count/group/compare actual icons; explicit unit/quantity verified",
      "decision": "EXACT_COUNT"
    },
    {
      "id": "POL-A-03",
      "condition": "Symbolic arithmetic (mental, vertical, reverse, three-addends, carry), no image learning goal",
      "decision": "DECORATIVE",
      "defaultShow": false
    },
    {
      "id": "POL-A-04",
      "condition": "Amount exceeds active renderer's approved limit",
      "decision": "KEEP_PEDAGOGIC_MODE_AND_BLOCK_EXACT_COUNT",
      "note": "Do not switch implicitly to representative to fake exact visual quantity"
    },
    {
      "id": "POL-A-05",
      "condition": "Word problem shows representative asset with any numerals",
      "decision": "REPRESENTATIVE",
      "note": "Rendering does not assert a numerical correspondence"
    }
  ],
